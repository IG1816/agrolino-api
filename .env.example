# Copie para .env e ajuste.
DATABASE_URL=postgresql+asyncpg://agrolino:agrolino@localhost:5432/agrolino
# Segredo para assinar cookies de sessão (mín. 32 bytes em produção).
SESSION_SECRET=change-me-use-openssl-rand-hex-32
# Ambiente: development | production
ENVIRONMENT=development
# Cookie Secure: em dev com HTTP local, use false; em produção sempre true.
SESSION_COOKIE_SECURE=false
